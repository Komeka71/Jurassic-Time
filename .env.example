# Copy this file to .env and fill in real values. .env is git-ignored.

# Required. MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/jurassic-museum
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/jurassic-museum
MONGO_URI=mongodb://127.0.0.1:27017/jurassic-museum

# Optional. Defaults shown.
NODE_ENV=development
PORT=5000

# Optional. Comma-separated list of origins allowed to call this API.
# Defaults to the Vite dev server origin if omitted. Vite auto-increments
# past 5173 if that port is already taken (5174, 5175, ...) — list every
# port your team actually runs the frontend on, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175